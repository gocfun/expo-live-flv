{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "src",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
