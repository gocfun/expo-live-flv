{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "src",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "react",
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
