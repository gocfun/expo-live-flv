{
  "name": "@gocfun/expo-live-flv",
  "version": "1.0.0",
  "description": "Unstyled HTTP-FLV live playback with bounded reconnect and lifecycle handling for Expo native apps",
  "license": "MIT",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "files": [
    "build",
    "app.plugin.js",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "plugin",
    "VALIDATION.md",
    "RELEASE.md",
    "DEVICE_TESTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepack": "pnpm build && node scripts/check-release.cjs",
    "release:check": "node scripts/check-release.cjs",
    "prepublishOnly": "pnpm test && node scripts/check-release.cjs",
    "test:package": "node scripts/smoke-package.cjs"
  },
  "peerDependencies": {
    "expo": "^54.0.37 || ^58.0.23",
    "expo-libvlc-player": "4.0.5",
    "react": ">=19.1.0 <20.0.0",
    "react-native": "^0.81.5 || ^0.88.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "react-test-renderer": "19.3.0",
    "expo": "58.0.23",
    "expo-libvlc-player": "4.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@types/node": "22.14.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./build/index.js",
      "default": "./build/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "expo",
    "react-native",
    "http-flv",
    "livestream",
    "libvlc",
    "srs",
    "flv",
    "live-streaming",
    "low-latency",
    "vlc",
    "video-player"
  ],
  "author": "Windy Nguyen <thewind0811@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gocfun/expo-live-flv.git"
  },
  "homepage": "https://github.com/gocfun/expo-live-flv#readme",
  "bugs": {
    "url": "https://github.com/gocfun/expo-live-flv/issues"
  }
}
